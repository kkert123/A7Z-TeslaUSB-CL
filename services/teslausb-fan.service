[Unit]
Description=TeslaUSB Fan Temperature Control
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/radxa_data/teslausb
ExecStart=/usr/bin/python3 -u /opt/radxa_data/teslausb/fan_control.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
