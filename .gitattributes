# Auto detect text files and perform LF normalization
* text=auto

# Python: force LF
*.py text eol=lf

# Shell scripts: force LF (critical for Linux deploy)
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf

# Web: force LF
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Proto/JSON/Config: force LF
*.proto text eol=lf
*.json text eol=lf
*.svg text eol=lf

# Binary
*.jpg binary
*.png binary
*.gif binary

# 运维脚本必须是 LF：CRLF 会让 shebang 变成 /bin/bash\r（bad interpreter），
# conf 里的 \r 还会让字符串比较失败
ops/a7z-local-route/* text eol=lf
