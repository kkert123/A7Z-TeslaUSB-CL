# guardian-b 环境变量样例
# 部署：复制为 /opt/guard-b/guard-b.env，改完 chmod 600，由 systemd EnvironmentFile 装载。
# 切勿把本文件（含真实 token / webhook key）提交进仓库。

# ── 鉴权（必填）──────────────────────────────────────────────
# ≥32 字节随机串：openssl rand -hex 32
GUARD_TOKEN=

# ── 监听 ────────────────────────────────────────────────────
# 仅 loopback（公网由 OpenResty 终结 TLS 后反代到此）；
# 若只走 Tailscale 隧道（v1.0.0 起的默认部署），这里填 TS 地址、8899 端口。
GUARD_BIND_HOST=127.0.0.1
GUARD_BIND_PORT=8800

# ── 判死阈值（§4：WARN=3T, ALARM=5T, T=60s）──────────────────
GUARD_T=60
GUARD_WARN_MULT=3
GUARD_ALARM_MULT=5
GUARD_JUDGE_INTERVAL=30

# ── 预期离线兜底窗口（秒）────────────────────────────────────
# A 端 v0.3.1.76+ 会直接带 offline_s（相对窗口），这里只在旧版 A / 字段缺失时兜底。
GUARD_OFFLINE_DEFAULT_S=3600

# ── 告警去重窗口（秒）────────────────────────────────────────
GUARD_DEDUP_S=1800

# ── 未知车态策略：judge（默认，宁误勿漏）| silent（宁漏勿扰）──
GUARD_UNKNOWN_VEHICLE=judge

# ── 状态与日志 ──────────────────────────────────────────────
GUARD_STATE_PATH=/opt/guard-b/data/state.json
GUARD_LOG_PATH=/opt/guard-b/data/guard-b.log
# 运行期覆盖（v1.0.2）：A 端设置页保存机器人 key 时会写这里（0600），
# 优先级 runtime > 本文件 > 默认值 —— 所以 UI 改过的 key 重启也不会被 env 顶回去。
GUARD_RUNTIME_PATH=/opt/guard-b/data/runtime.json

# ── 企业微信机器人（B 端用于「设备失联」告警）──────────────────
# 可以留空：A 端设置页保存「A7Z 守护」机器人时会自动下发到 runtime.json。
GUARD_WECOM_KEY=
# 或直接给完整 URL（优先于 key）：
GUARD_WECOM_URL=
# 调试期可置 1：告警只打日志，不外发（日志里会带 [DRY-RUN]，状态页 mode=dryrun）
GUARD_ALERT_DRY_RUN=0

# ── 外部 dead-man（§10 R5；healthchecks.io / Uptime-Kuma ping URL）──
GUARD_DEADMAN_URL=
GUARD_DEADMAN_INTERVAL=3600

# ── 行为开关 ────────────────────────────────────────────────
GUARD_JUDGE_ENABLE=1
# 1 = /guard/status 免鉴权（仅建议在只读、内网场景开）
GUARD_PUBLIC_STATUS=0

# ── 远程升级（v1.1.0；**默认关闭**）────────────────────────────
# 0 = 所有 /guard/upgrade/* 一律 403。这是安全默认值，不是"没配好"。
# 打开前请确认三项同时成立（缺一仍会 403）：
#   1) /opt/guard-b/.trusted/pkg.pub 存在且 principal 为 a7z-guard
#   2) 本文件 GUARD_UPGRADE_ENABLE=1
#   3) 发起方来自 Tailscale 网段（GUARD_TS_CIDR）
GUARD_UPGRADE_ENABLE=0
# 只接受该网段的升级请求。不要为了"方便"改成 0.0.0.0/0。
GUARD_TS_CIDR=100.64.0.0/10
# 是否也允许本机回环发起（调试用；生产可置 0）
GUARD_UPGRADE_ALLOW_LOOPBACK=1
# 确认码是否也通过 /guard/status 返回：
#   0 = 只能看 `journalctl -u guard-b` / data/guard-b.log（**真正的带外确认**，默认）
#   1 = 便利模式：A 端能自动读到码 —— 但这也意味着"拿到 A 的攻击者能全自动完成"，
#       等于把人工确认降级成"人看一眼"。打开前确认你接受这个折中。
GUARD_UPGRADE_CODE_VIA_API=0

# 升级相关路径（一般不用改）
GUARD_UPGRADE_DIR=/opt/guard-b/data/upgrade
GUARD_UPGRADE_PUBKEY=/opt/guard-b/.trusted/pkg.pub
GUARD_UPGRADE_FLOOR=/opt/guard-b/.trusted/floor
GUARD_RELEASES_DIR=/opt/guard-b/releases
# 触发 root helper 的方式。**默认留空** = 写请求文件，由
# `guardb-upgrade.path` 监听后拉起 `guardb-upgrade.service`（推荐）。
# 为什么不用 `sudo systemctl start ...`：guard-b.service 开着
# NoNewPrivileges=yes，NNP 会禁止 sudo 提权 —— 两者互斥，写 sudo 必然失败。
# 只有明确放弃 NNP 时才填一条命令。
GUARD_UPGRADE_APPLY_CMD=
